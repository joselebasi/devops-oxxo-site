---
import '../styles/global.css';
import { Image } from 'astro:assets';
import { Moon, Sun } from 'lucide-react';
import engineeringLogo from '../assets/logo-ingenieria-staff.png';
import { OrganizationSwitcher, Show, SignInButton, SignUpButton, UserButton } from '@clerk/astro/components';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Proyecto DevOps OXXO.',
} = Astro.props;
const requestedTheme = Astro.url.searchParams.get('tema');
const theme = requestedTheme === 'dark' || requestedTheme === 'light'
  ? requestedTheme
  : Astro.cookies.get('theme')?.value === 'dark' ? 'dark' : 'light';
if (requestedTheme === 'dark' || requestedTheme === 'light') {
  Astro.cookies.set('theme', theme, {
    path: '/', sameSite: 'lax', httpOnly: true,
    secure: Astro.url.protocol === 'https:', maxAge: 60 * 60 * 24 * 365,
  });
}

function themeUrl(selectedTheme: 'light' | 'dark') {
  const query = new URLSearchParams(Astro.url.searchParams);
  query.set('tema', selectedTheme);
  return `${Astro.url.pathname}?${query}`;
}
---

<!doctype html>
<html lang="es" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="grid min-h-dvh grid-rows-[auto_1fr_auto] font-sans antialiased">
    <header class="w-full border-t-4 border-t-brand border-b border-b-neutral-300 bg-white">
      <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-6 sm:px-10">
      <a href="/" aria-label="Inicio de DevOps OXXO" class="inline-flex max-w-full items-center gap-3 text-lg font-bold text-brand">
        <Image
          src={engineeringLogo}
          alt="Ingenieria Staff OXXO"
          width={96}
          widths={[96, 192]}
          sizes="(min-width: 640px) 96px, 80px"
          format="webp"
          quality={85}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="h-[52.8px] w-auto shrink-0 sm:h-[63.36px]"
        />
        <span aria-hidden="true" class="h-10 w-px shrink-0 bg-neutral-400 sm:h-12"></span>
        <img
          src="/logocolor.png"
          alt="Axity"
          width="96"
          height="36"
          class="h-[38.72px] w-auto shrink-0 sm:h-[46.464px]"
          decoding="async"
        />
      </a>
      <div class="flex flex-wrap items-center gap-5">
        <nav aria-label="Apariencia" class="flex shrink-0 gap-1 rounded-md border border-neutral-300 bg-white p-1">
          <a href={themeUrl('light')} aria-label="Modo claro" title="Modo claro" aria-current={theme === 'light' ? 'true' : undefined}
            class:list={['inline-flex size-11 items-center justify-center rounded', theme === 'light' ? 'bg-emerald-50 text-emerald-800' : 'text-neutral-600 hover:bg-neutral-100']}>
            <Sun size={19} aria-hidden="true" />
          </a>
          <a href={themeUrl('dark')} aria-label="Modo oscuro" title="Modo oscuro" aria-current={theme === 'dark' ? 'true' : undefined}
            class:list={['inline-flex size-11 items-center justify-center rounded', theme === 'dark' ? 'bg-emerald-50 text-emerald-800' : 'text-neutral-600 hover:bg-neutral-100']}>
            <Moon size={19} aria-hidden="true" />
          </a>
        </nav>
        {import.meta.env.DEV && <span class="inline-flex items-center gap-2 text-sm text-neutral-600">
          <span class="size-2 rounded-full bg-emerald-700" aria-hidden="true"></span>
          Entorno local
        </span>}
        <nav aria-label="Cuenta" class="flex min-w-0 flex-wrap items-center gap-3">
          <Show when="signed-out">
            <SignInButton asChild mode="modal">
              <button type="button" class="min-h-11 rounded-md border border-neutral-300 bg-white px-4 text-sm font-semibold hover:bg-neutral-100">Iniciar sesion</button>
            </SignInButton>
            <SignUpButton asChild mode="modal">
              <button type="button" class="min-h-11 rounded-md bg-brand px-4 text-sm font-semibold text-white hover:brightness-90">Registrarse</button>
            </SignUpButton>
          </Show>
          <Show when="signed-in">
            <OrganizationSwitcher
              hidePersonal
              afterSelectOrganizationUrl="/"
              afterCreateOrganizationUrl="/"
              afterLeaveOrganizationUrl="/"
            />
            <UserButton />
          </Show>
        </nav>
      </div>
      </div>
    </header>
    <slot />
    <footer class="w-full border-t border-neutral-300 bg-white">
      <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-3 px-5 py-5 text-sm text-neutral-600 sm:px-10">
        <span class="font-semibold text-ink">DevOps OXXO</span>
        <span>Infraestructura y DevOps</span>
      </div>
    </footer>
  </body>
</html>
